# ============================================================================
# En-têtes de sécurité — Cloudflare Pages (fichier spécial, non servi au public).
# S'applique à TOUTES les routes du site. Objectif : durcir contre clickjacking,
# MIME-sniffing, injection, et forcer HTTPS. Ajouté suite à l'audit sécurité 20/07.
# ⚠️ Si une page casse après déploiement, le suspect n°1 est la Content-Security-Policy
#    ci-dessous (assouplir la directive concernée). Tester sur elysium-x57.pages.dev.
# ============================================================================
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://xchahmcflineiupqmges.supabase.co; font-src 'self'; connect-src 'self' https://api.web3forms.com https://cloudflareinsights.com https://xchahmcflineiupqmges.supabase.co wss://xchahmcflineiupqmges.supabase.co; form-action 'self' https://api.web3forms.com; upgrade-insecure-requests

# ----------------------------------------------------------------------------
# ESPACE COACHS seulement (/coach, /coach.html, /coach-maquette) — 02/10 : envoi de la fiche PDF depuis Gmail.
# Même règle que ci-dessus, plus Google : la bibliothèque de connexion (script + fenêtre), l'envoi du mail
# (gmail.googleapis.com) et la lecture de l'adresse connectée (www.googleapis.com/oauth2/).
# « ! » retire la règle générale pour ces chemins : sans lui, les deux règles s'additionnent et la plus
# stricte gagne (Google resterait bloqué). Le reste du site garde la règle générale, inchangée.
# ----------------------------------------------------------------------------
/coach*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://xchahmcflineiupqmges.supabase.co; font-src 'self'; connect-src 'self' https://api.web3forms.com https://cloudflareinsights.com https://xchahmcflineiupqmges.supabase.co wss://xchahmcflineiupqmges.supabase.co https://accounts.google.com/gsi/ https://gmail.googleapis.com https://www.googleapis.com/oauth2/; frame-src https://accounts.google.com/gsi/; form-action 'self' https://api.web3forms.com; upgrade-insecure-requests
